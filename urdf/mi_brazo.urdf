<?xml version="1.0"?>
<robot name="Brazo_50cm_Preciso">
  <link name="base_link">
    <visual>
      <geometry><mesh filename="urdf/mesh/Base_Brazo_Robotico.stl" scale="0.00035 0.00035 0.00035"/></geometry>
    </visual>
    <collision>
      <geometry><mesh filename="urdf/mesh/Base_Brazo_Robotico.stl" scale="0.00035 0.00035 0.00035"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <joint name="base_joint" type="revolute">
    <parent link="base_link"/><child link="base_rotation"/>
    <origin xyz="0 0 0.028"/><axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="300" velocity="5"/>
  </joint>

  <link name="base_rotation">
    <visual><geometry><mesh filename="urdf/mesh/Base_Rotacional.stl" scale="0.00035 0.00035 0.00035"/></geometry></visual>
    <collision><geometry><mesh filename="urdf/mesh/Base_Rotacional.stl" scale="0.00035 0.00035 0.00035"/></geometry></collision>
    <inertial><mass value="0.4"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_rotation"/><child link="link1"/>
    <origin xyz="0 0 0.0157"/><axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="300" velocity="3"/>
  </joint>

  <link name="link1">
    <visual><geometry><mesh filename="urdf/mesh/Link1.stl" scale="0.00035 0.00035 0.00035"/></geometry></visual>
    <collision><geometry><mesh filename="urdf/mesh/Link1.stl" scale="0.00035 0.00035 0.00035"/></geometry></collision>
    <inertial><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0.1764 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="300" velocity="3"/>
  </joint>

  <link name="link2">
    <visual><geometry><mesh filename="urdf/mesh/Link2.stl" scale="0.00035 0.00035 0.00035"/></geometry></visual>
    <collision><geometry><mesh filename="urdf/mesh/Link2.stl" scale="0.00035 0.00035 0.00035"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/></inertial>
  </link>

  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="link2"/><child link="Link3"/>
    <origin xyz="0.1484 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="3"/>
  </joint>

  <link name="Link3">
    <visual><geometry><mesh filename="urdf/mesh/Link3.stl" scale="0.00035 0.00035 0.00035"/></geometry></visual>
    <collision><geometry><mesh filename="urdf/mesh/Link3.stl" scale="0.00035 0.00035 0.00035"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>

  <joint name="wrist_yaw_joint" type="revolute">
    <parent link="Link3"/><child link="Link4"/>
    <origin xyz="0.1207 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="3"/>
  </joint>

  <link name="Link4">
    <visual><geometry><mesh filename="urdf/mesh/Link4.stl" scale="0.00035 0.00035 0.00035"/></geometry></visual>
    <collision><geometry><mesh filename="urdf/mesh/Link4.stl" scale="0.00035 0.00035 0.00035"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/></inertial>
  </link>

  <joint name="end_effector_joint" type="fixed">
    <parent link="Link4"/><child link="end_effector"/>
    <origin xyz="0.0525 0 0"/>
  </joint>

  <link name="end_effector">
    <inertial><mass value="0.0001"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial>
  </link>
</robot>