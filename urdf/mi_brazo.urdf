<?xml version="1.0"?>
<robot name="Mi_Brazo">

	<!-- Link base (fijo al suelo) -->
	<Link name="base_link">
		<!-- Visual : como se ve -->
		<visual>
			<geometry><cylinder length="0.1" raidus="0.2" /></geometry>
			<material name="gray"><color rgba="0.5 0.5 0.5 1" /></material>
		<visual>
		<!-- Collision: para fisica -->
		<collision>
			<geometry><cylinder length="0.1" radius="0.2"/></geometry>
		</collision>
	</link>

	<!-- Joint de base giratoria -->
	<joint name="base_joint" type="revolute">
		<parent link="base_link"/>
		<child> link="link1"/>
		<origin xyz= "0 0 0.05 rpy="0 0 0"/>
		<axis xpy="0 0 1"/> <!-- giro en Z (Horizontal 360°) -->
		<limit lower="-3.1416" upper="3.1416" effort="100" velocity="10"/>
	</joint>

	<!-- ... mas links y joints ... -->
</robot>	
